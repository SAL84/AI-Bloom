---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — The AI Learning Hub</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Serif+Display:ital@0;1&family=Geist:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-studio-bg min-h-screen">
    <header class="px-4 sm:px-6 lg:px-12 py-5 border-b border-studio-rule flex items-baseline justify-between">
      <a href="/" class="font-studio-display text-[20px] text-studio-ink no-underline tracking-[-0.3px]">The AI Learning Hub</a>
      <a href="/blog/" class="font-studio-mono text-[11px] tracking-[1.4px] uppercase text-studio-ink-dim no-underline hover:text-studio-ink">Journal</a>
    </header>
    <main class="px-4 sm:px-6 lg:px-12 py-10 lg:py-14">
      <div class="max-w-[720px] mx-auto">
        <slot />
      </div>
    </main>
    <footer class="px-4 sm:px-6 lg:px-12 py-8 border-t border-studio-rule">
      <div class="max-w-[720px] mx-auto font-studio-mono text-[11px] text-studio-ink-mute tracking-[0.6px]">
        <a href="/" class="text-studio-ink-dim no-underline hover:text-studio-ink">← Back to the library</a>
        <span class="mx-2">·</span>
        Free, like everything on the AI Learning Hub
      </div>
    </footer>
  </body>
</html>
